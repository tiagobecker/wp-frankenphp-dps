COMPOSE_PROJECT_NAME={{app_name}}
WORDPRESS_HOME=https://{{domain}}
WORDPRESS_SITEURL=https://{{domain}}
SERVER_NAME=:80
WORDPRESS_DB_NAME=wordpress_{{subscription_id}}_{{subscription_item_id}}
WORDPRESS_DB_USER=wp_{{user_id}}
WORDPRESS_DB_PASSWORD={{database_password}}
WORDPRESS_TABLE_PREFIX=wp_{{subscription_id}}_
MARIADB_ROOT_PASSWORD={{master_key}}
WORDPRESS_AUTO_INSTALL=true
WORDPRESS_SITE_TITLE=WordPress FrankenPHP {{subscription_id}}-{{subscription_item_id}}
WORDPRESS_ADMIN_USER=admin_{{user_id}}
WORDPRESS_ADMIN_PASSWORD={{admin_password}}
WORDPRESS_ADMIN_EMAIL={{admin_email}}
WORDPRESS_LOCALE=pt_BR
WORDPRESS_ENVIRONMENT_TYPE=production
WORDPRESS_DEBUG=false
WORDPRESS_CONFIG_EXTRA=
WORDPRESS_FORCE_SSL_ADMIN=true
WORDPRESS_DISABLE_WP_CRON=true
WORDPRESS_CRON_INTERVAL=60
WORDPRESS_INSTALL_REDIS_PLUGIN=false
STARTUP_WAIT_TIMEOUT=0
STARTUP_WAIT_INTERVAL=5
WORDPRESS_AUTH_KEY={{secret}}-auth-key
WORDPRESS_SECURE_AUTH_KEY={{jwt_refresh_secret}}-secure-auth-key
WORDPRESS_LOGGED_IN_KEY={{token_admin}}-logged-in-key
WORDPRESS_NONCE_KEY={{master_key}}-nonce-key
WORDPRESS_AUTH_SALT={{redis_password}}-auth-salt
WORDPRESS_SECURE_AUTH_SALT={{rabbitmq_password}}-secure-auth-salt
WORDPRESS_LOGGED_IN_SALT={{database_password}}-logged-in-salt
WORDPRESS_NONCE_SALT={{admin_password}}-nonce-salt
FRANKENPHP_IMAGE=dunglas/frankenphp:1-php8.5-trixie
MARIADB_IMAGE=mariadb:11
REDIS_IMAGE=redis:7-alpine
FRANKENPHP_NUM_THREADS=2
FRANKENPHP_MAX_THREADS=auto
FRANKENPHP_MAX_REQUESTS=1000
FRANKENPHP_MAX_WAIT_TIME=30s
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=256M
PHP_POST_MAX_SIZE=256M
PHP_MAX_INPUT_VARS=5000
GOMEMLIMIT=768MiB
WORDPRESS_CPUS=1.0
WORDPRESS_MEMORY_LIMIT=1024M
WORDPRESS_MEMORY_RESERVATION=512M
WP_CRON_CPUS=0.25
WP_CRON_MEMORY_LIMIT=256M
MARIADB_CPUS=1.0
MARIADB_MEMORY_LIMIT=1024M
MARIADB_MEMORY_RESERVATION=512M
REDIS_CPUS=0.25
REDIS_MEMORY_LIMIT=256M

# Slow-host/reboot tolerance.
WORDPRESS_HEALTHCHECK_INTERVAL=10s
WORDPRESS_HEALTHCHECK_TIMEOUT=10s
WORDPRESS_HEALTHCHECK_RETRIES=30
WORDPRESS_HEALTHCHECK_START_PERIOD=180s
MARIADB_HEALTHCHECK_INTERVAL=10s
MARIADB_HEALTHCHECK_TIMEOUT=10s
MARIADB_HEALTHCHECK_RETRIES=30
MARIADB_HEALTHCHECK_START_PERIOD=180s
REDIS_HEALTHCHECK_INTERVAL=10s
REDIS_HEALTHCHECK_TIMEOUT=5s
REDIS_HEALTHCHECK_RETRIES=30
REDIS_HEALTHCHECK_START_PERIOD=60s
WORDPRESS_STOP_GRACE_PERIOD=60s
WP_CRON_STOP_GRACE_PERIOD=30s
MARIADB_STOP_GRACE_PERIOD=120s
REDIS_STOP_GRACE_PERIOD=30s
MARIADB_INNODB_BUFFER_POOL_SIZE=384M
MARIADB_MAX_CONNECTIONS=100
REDIS_MAXMEMORY=128mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
DPS_VOLUME_DRIVER=dps
WORDPRESS_VOLUME_SIZE=10G
WORDPRESS_VOLUME_INODES=500000
MARIADB_VOLUME_SIZE=5G
MARIADB_VOLUME_INODES=300000
REDIS_VOLUME_SIZE=1G
REDIS_VOLUME_INODES=100000
